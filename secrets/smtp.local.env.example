# Copy this file to: ../.dev.vars  (gitignored)
# Do NOT paste secrets into chat. Do NOT commit .dev.vars.
#
# NetEase enterprise mail (leaf@zbens.com):
#   1. Login https://mail.ym.163.com/ as leaf@zbens.com
#   2. Settings → POP3/SMTP/IMAP → enable SMTP → create auth code
#   3. Fill values below (host/port as shown in that page)

SMTP_HOST=smtp.ym.163.com
SMTP_PORT=465
SMTP_USER=leaf@zbens.com
SMTP_PASS=
SMTP_FROM=leaf@zbens.com

# Paddle Dashboard → Developer tools → Notifications → endpoint secret
PADDLE_WEBHOOK_SECRET=

# Paddle API key (Server-side) — used to fetch buyer email when webhook omits it
# Dashboard → Developer tools → Authentication → API keys
PADDLE_API_KEY=

# Must match HDRecover.UI LicenseManager.OfflineHmacMaterial (default OK for v1)
LICENSE_HMAC_SECRET=HDRecover.Offline.License.v1.DoNotShare
